[
  {"id":"n01","shot":1,"voice":"narrator","at":2.0,"dur":7.0,"text":"Manusia selalu percaya bahwa waktu bergerak maju. Bahwa setiap kejadian memiliki awal dan akhir."},
  {"id":"n02","shot":2,"voice":"narrator","at":11.0,"dur":9.5,"text":"Tetapi bagaimana jika ada sesuatu yang mengetahui apa yang akan terjadi... bahkan sebelum itu terjadi?"},
  {"id":"a04a","shot":4,"voice":"adrian","at":41.0,"dur":3.5,"text":"Siapa yang telepon jam segini..."},
  {"id":"a04b","shot":4,"voice":"adrian","at":49.0,"dur":2.0,"text":"Adrian?"},
  {"id":"a05a","shot":5,"voice":"adrian","at":56.0,"dur":1.5,"text":"Halo?"},
  {"id":"c05a","shot":5,"voice":"caller","at":61.0,"dur":4.0,"fx":"phone","text":"Adrian... dengarkan aku baik-baik."},
  {"id":"a05b","shot":5,"voice":"adrian","at":66.0,"dur":2.0,"text":"Siapa ini?"},
  {"id":"c05b","shot":5,"voice":"caller","at":69.0,"dur":3.0,"fx":"phone","text":"Kamu tidak punya banyak waktu."},
  {"id":"c06a","shot":6,"voice":"caller","at":77.0,"dur":4.0,"fx":"phone","text":"Sebentar lagi seseorang akan mengetuk pintumu."},
  {"id":"a06a","shot":6,"voice":"adrian","at":82.0,"dur":2.0,"text":"Apa maksudmu?"},
  {"id":"c06b","shot":6,"voice":"caller","at":85.0,"dur":2.5,"fx":"phone","text":"Jangan buka pintunya."},
  {"id":"a07","shot":7,"voice":"adrian","at":102.0,"dur":3.0,"text":"Ini pasti lelucon..."},
  {"id":"s08a","shot":8,"voice":"stranger","at":122.0,"dur":2.0,"label":"SUARA DARI LUAR","text":"Adrian?"},
  {"id":"s08b","shot":8,"voice":"stranger","at":126.0,"dur":3.0,"label":"SUARA DARI LUAR","text":"Aku tahu kamu di dalam."},
  {"id":"a09a","shot":9,"voice":"adrian","at":150.0,"dur":3.0,"text":"Siapa sebenarnya kamu?!"},
  {"id":"c09a","shot":9,"voice":"caller","at":154.0,"dur":4.0,"fx":"phone","text":"Aku sudah bilang... jangan buka pintunya."},
  {"id":"a09b","shot":9,"voice":"adrian","at":159.0,"dur":3.0,"text":"Siapa orang di luar?!"},
  {"id":"c09b","shot":9,"voice":"caller","at":163.0,"dur":5.0,"fx":"phone","text":"Adrian... dia bukan orang yang seharusnya ada di sana."},
  {"id":"a10","shot":10,"voice":"adrian","at":171.0,"dur":3.0,"text":"Apa yang sebenarnya terjadi?!"},
  {"id":"c10","shot":10,"voice":"caller","at":176.0,"dur":5.0,"fx":"phone","text":"Dengarkan aku. Apa pun yang kamu lihat, jangan percaya."},
  {"id":"r11","shot":11,"voice":"recording","at":202.0,"dur":5.0,"text":"Jika kamu sedang melihat ini... berarti semuanya terulang lagi."},
  {"id":"c12","shot":12,"voice":"caller","at":220.0,"dur":3.0,"fx":"whisper","text":"Jangan... menoleh."},
  {"id":"s13","shot":13,"voice":"stranger","at":234.0,"dur":3.2,"text":"Akhirnya... kita bertemu lagi."}
]
