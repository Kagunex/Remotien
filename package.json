{
  "name": "the-last-signal",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts Part01 out/part01.mp4 --codec=h264 --audio-codec=aac --fps=60",
    "still:sheet": "remotion still src/index.ts CharacterSheet out/character-sheet.png",
    "audio": "python3 scripts/generate_audio.py",
