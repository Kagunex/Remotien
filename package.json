{
  "name": "internet-motion",
  "version": "1.1.0",
  "private": true,
  "description": "Bagaimana Internet Bekerja? - 9:16 3D Educational Motion Graphic (90s, 8 Scenes) built with Remotion & React Three Fiber",
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion bundle",
    "smoke": "remotion still src/index.ts InternetExplained out/smoke-0.jpeg --frame=0 --gl=angle",
    "render": "remotion render src/index.ts InternetExplained out/bagaimana-internet-bekerja-9x16.mp4 --gl=angle",
    "tts:generate": "node scripts/generate-elevenlabs-vo.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@react-three/fiber": "^8.17.10",
    "@remotion/cli": "^4.0.240",
    "@remotion/media": "^4.0.240",
    "@remotion/three": "^4.0.240",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.240",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.170.0",
    "typescript": "^5.6.3"
  }
}
